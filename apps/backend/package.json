{
  "name": "backend",
  "version": "1.0.50",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "db:generate": "bunx --bun prisma generate",
    "db:push":"bunx --bun prisma db push --force-reset",
    "db:reset":"bun run db:generate && bun run db:push",
    "auth:generate": "bunx --bun auth@latest generate",
    "postinstall": "bun run db:generate"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.9",
    "@elysiajs/cors": "^1.4.2",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-auth": "^1.6.9",
    "elysia": "latest",
    "@repo/domain": "*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "prisma": "^7.8.0"
  },
  "module": "src/index.js"
}
